{
  "name": "ecommerce-mern",
  "version": "1.0.0",
  "description": "MERN E-commerce application (client + server)",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client start",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm --prefix client run build",
    "start:server": "NODE_ENV=production npm --prefix server start"
  },
  "keywords": [
    "mern",
    "ecommerce"
  ],
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
